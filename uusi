#include <stdio.h>
#include <stdint.h>
#include <math.h>
#include <pico/stdlib.h>
#include <FreeRTOS.h>
#include <task.h>
#include "tkjhat/sdk.h"

#define DEFAULT_STACK_SIZE 2048
#define SENSOR_DELAY_MS    50
#define PRINT_DELAY_MS     50
#define THRESHOLD_G        0.8f

#define SW1_FLAG (1 << 0)
#define SW2_FLAG (1 << 1)

typedef enum {
    WAITING,
    BUTTON_PRESSED,
    SEND_SYMBOL
} state_t;

typedef enum {
    ASENTO_EI = 0,
    ASENTO_YLOS,
    ASENTO_ALAS,
    ASENTO_SIVULLA
} asento_t;

typedef struct {
    float ax;
    float ay;
    float az;
} accel_t;

volatile state_t programState = WAITING;
volatile uint8_t buttonFlags = 0;
volatile char symbol = 0;
volatile asento_t asento_tila = ASENTO_EI;

// Käsittelee nappien painallukset
static void nappi(uint gpio, uint32_t eventMask) {
    if (programState != WAITING) {
        return;
    }
    if (gpio == BUTTON1) {
        buttonFlags |= SW1_FLAG;
    } else if (gpio == BUTTON2) {
        buttonFlags |= SW2_FLAG;
    }
    programState = BUTTON_PRESSED;
}

// Lukee kiihtyvyysanturin asennon
static void asento(accel_t *data) {
    float gx, gy, gz, t;
    ICM42670_read_sensor_data(&data->ax, &data->ay, &data->az, &gx, &gy, &gz, &t);
}

// Tunnistaa symbolin ja asennon (ylös, alas, sivulla)
static char tunnista_symboli(const accel_t *data, volatile asento_t *tila) {
    if (data->az > THRESHOLD_G) {
        *tila = ASENTO_YLOS;
        return '.';
    }
    if (data->az < -THRESHOLD_G) {
        *tila = ASENTO_ALAS;
        return '-';
    }
    if (fabsf(data->ax) > THRESHOLD_G || fabsf(data->ay) > THRESHOLD_G) {
        *tila = ASENTO_SIVULLA;
        return '-';
    }
    *tila = ASENTO_EI;
    return 0;
}

// Käsittelee sensorin tapahtumat
static void sensori(void *arg) {
    accel_t accel;

    init_ICM42670();
    ICM42670_start_with_default_values();

    while (1) {
        if (programState == BUTTON_PRESSED) {
            if (buttonFlags & SW1_FLAG) {
                asento(&accel);
                symbol = tunnista_symboli(&accel, &asento_tila);
            } else if (buttonFlags & SW2_FLAG) {
                symbol = ' ';
                asento_tila = ASENTO_EI;
            }

            buttonFlags = 0;

            if (symbol != 0) {
                programState = SEND_SYMBOL;
            } else {
                programState = WAITING;
            }
        }
        vTaskDelay(pdMS_TO_TICKS(SENSOR_DELAY_MS));
    }
}

// Tulostaa morsen sekä asennon näkyville ja käsittelee ledit
static void tulostus(void *arg) {
    while (1) {
        if (programState == SEND_SYMBOL) {
            const char *teksti = "";
            if (asento_tila == ASENTO_YLOS) {
                teksti = "(ylös)";
            } else if (asento_tila == ASENTO_ALAS) {
                teksti = "(alas)";
            } else if (asento_tila == ASENTO_SIVULLA) {
                teksti = "(sivulla)";
            }

            printf("%c%s", symbol, teksti);
            fflush(stdout);
            toggle_led();

            symbol = 0;
            asento_tila = ASENTO_EI;
            programState = WAITING;
        }
        vTaskDelay(pdMS_TO_TICKS(PRINT_DELAY_MS));
    }
}

int main(void) {
    stdio_init_all();
    init_hat_sdk();
    sleep_ms(300);

    init_led();
    init_sw1();
    init_sw2();

    gpio_set_irq_enabled_with_callback(BUTTON1, GPIO_IRQ_EDGE_RISE, true, nappi);
    gpio_set_irq_enabled(BUTTON2, GPIO_IRQ_EDGE_RISE, true);

    xTaskCreate(sensori, "sensor", DEFAULT_STACK_SIZE, NULL, 2, NULL);
    xTaskCreate(tulostus, "print", DEFAULT_STACK_SIZE, NULL, 2, NULL);

    vTaskStartScheduler();

    return 0;
}
