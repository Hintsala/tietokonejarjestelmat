//Tiitus Hintsala ja Johan Viljamaa, yhdessä toteutettu koodi joten koodiin ei ole erikseen merkattu tekijää
 

#include <stdio.h>
#include <stdint.h>
#include <math.h>
#include <pico/stdlib.h>
#include <FreeRTOS.h>
#include <task.h>
#include "tkjhat/sdk.h"

#define muisti       2048
#define SENSORI_VIIVE   50
#define TULOSTUS_VIIVE  50
#define RAJA_ARVO       0.8f
#define HÄIRIÖ_VIIVE     200

// Ohjelman tilakoneen tilat
typedef enum {
    ODOTTAA = 1,
    NAPPI1_PAINETTU,
    NAPPI2_PAINETTU,
    TULOSTA_MERKKI
} tila_t;

// Kiihtyvyysanturin lukemat
typedef struct {
    float x;
    float y;
    float z;
} kiihtyvyys_t;

volatile tila_t ohjelman_tila = ODOTTAA;
volatile char lahetettava_merkki = 0;

// Keskeytyskäsittelijä molemmille napeille
void nappi_keskeytys(uint gpio, uint32_t eventMask) {
    static uint32_t edellinen_painallus = 0;
    uint32_t nyt = to_ms_since_boot(get_absolute_time());

    // Estetään kytkinvärähtelystä johtuvat tuplapainallukset
    if (nyt - edellinen_painallus < HÄIRIÖ_VIIVE) {
        return;
    }

    // Reagoidaan vain jos edellinen merkki on jo käsitelty
    if (ohjelman_tila != ODOTTAA) {
        return;
    }

    edellinen_painallus = nyt;

    if (gpio == BUTTON1) {
        ohjelman_tila = NAPPI1_PAINETTU;
    } else if (gpio == BUTTON2) {
        ohjelman_tila = NAPPI2_PAINETTU;
    }
}

// Päättelee morsemerkin levyn kallistuksen perusteella
char paattele_merkki(kiihtyvyys_t data) {
    // Levy vaakatasossa (Z-akseli pystyssä) -> piste
    if (fabsf(data.z) > RAJA_ARVO) {
        return '.';
    }
    // Levy kallistettuna sivulle tai pystyyn (X tai Y) -> viiva
    if (fabsf(data.x) > RAJA_ARVO || fabsf(data.y) > RAJA_ARVO) {
        return '-';
    }
    return 0;
}

// Taski kiihtyvyysanturin lukemiseen
void sensori_task(void *pvParameters) {
    kiihtyvyys_t mittaus;
    float gx, gy, gz, temp; // Ylimääräiset muuttujat SDK:n funktiota varten

    init_ICM42670();
    ICM42670_start_with_default_values();

    while (1) {
        if (ohjelman_tila == NAPPI1_PAINETTU) {
            ICM42670_read_sensor_data(&mittaus.x, &mittaus.y, &mittaus.z, &gx, &gy, &gz, &temp);
            lahetettava_merkki = paattele_merkki(mittaus);

            if (lahetettava_merkki != 0) {
                ohjelman_tila = TULOSTA_MERKKI;
            } else {
                // Jos asento oli epäselvä, palataan odottamaan
                ohjelman_tila = ODOTTAA;
            }
        } 
        else if (ohjelman_tila == NAPPI2_PAINETTU) {
            lahetettava_merkki = ' ';
            ohjelman_tila = TULOSTA_MERKKI;
        }

        vTaskDelay(pdMS_TO_TICKS(SENSORI_VIIVE));
    }
}

// Taski merkkien tulostamiseen ja ledin vilkuttamiseen
void tulostus_task(void *pvParameters) {
    while (1) {
        if (ohjelman_tila == TULOSTA_MERKKI) {
            printf("%c", lahetettava_merkki);
            fflush(stdout); // Pakotetaan tulostus heti ilman rivinvaihtoa
            toggle_led();

            lahetettava_merkki = 0;
            ohjelman_tila = ODOTTAA;
        }

        vTaskDelay(pdMS_TO_TICKS(TULOSTUS_VIIVE));
    }
}

int main(void) {
    stdio_init_all();
    init_hat_sdk();
    sleep_ms(300);

    init_led();
    init_sw1();
    init_sw2();

    // Otetaan keskeytykset käyttöön napeille
    gpio_set_irq_enabled_with_callback(BUTTON1, GPIO_IRQ_EDGE_RISE, true, &nappi_keskeytys);
    gpio_set_irq_enabled(BUTTON2, GPIO_IRQ_EDGE_RISE, true);

    xTaskCreate(sensori_task, "Sensori", muisti, NULL, 2, NULL);
    xTaskCreate(tulostus_task, "Tulostus", muisti, NULL, 2, NULL);

    vTaskStartScheduler();

    return 0;
}
